{
  "name": "tlms_esd",
  "version": "0.6.1",
  "description": "Pipeline Leakage Emergency Shutdown System",
  "type": "module",
  "exports": {
    "cli": "./cli.js",
    "default": "./main.js"
  },
  "peerDependencies": {
    "pm2": "^5.4.2"
  },
  "devDependencies": {
    "@st-one-io/nodes7": "^1.1.2",
    "csv-parser": "^3.2.1",
